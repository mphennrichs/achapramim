# HTTP
HTTP_PORT=8080

# CORS — origens que podem chamar a API (separadas por vírgula). Sem definir,
# libera qualquer localhost:* (padrão de desenvolvimento). Em produção só é
# necessário se frontend e backend NÃO estiverem sob o mesmo domínio (o
# roteamento Host+PathPrefix(/api) do Traefik já coloca ambos na mesma origem,
# então normalmente não precisa ser setado lá).
CORS_ALLOWED_ORIGINS=

# Postgres
DATABASE_URL=postgres://achapramim:achapramim@localhost:5432/achapramim?sslmode=disable

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_MINUTES=43200

# Bootstrap do primeiro admin — só usado se a tabela de users estiver vazia
ADMIN_EMAIL=
ADMIN_PASSWORD=

# LLM (Claude / Anthropic) — preenchimento por link e sugestão de sinônimos
ANTHROPIC_API_KEY=

# Scan — intervalo entre verificações de Watches devidos a rodar
SCAN_POLL_INTERVAL_SECONDS=60

# ibex-bot — notificações via WhatsApp (serviço HTTP separado)
IBEX_BOT_BASE_URL=
IBEX_BOT_TOKEN=

# Telegram — notificações via bot (deep-link t.me/<bot>?start=<token>)
TELEGRAM_BOT_TOKEN=
