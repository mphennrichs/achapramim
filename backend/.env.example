# HTTP
HTTP_PORT=8080

# Postgres
DATABASE_URL=postgres://achapramim:achapramim@localhost:5432/achapramim?sslmode=disable

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_MINUTES=43200

# Bootstrap do primeiro admin — só usado se a tabela de users estiver vazia
ADMIN_EMAIL=
ADMIN_PASSWORD=

# LLM (Claude / Anthropic) — preenchimento por link e sugestão de sinônimos
ANTHROPIC_API_KEY=

# Mercado Livre — credencial única do sistema (não por usuário)
MERCADO_LIVRE_APP_ID=
MERCADO_LIVRE_APP_SECRET=

# ibex-bot — notificações via WhatsApp (serviço HTTP separado)
IBEX_BOT_BASE_URL=
IBEX_BOT_TOKEN=

# Telegram — notificações via bot (deep-link t.me/<bot>?start=<token>)
TELEGRAM_BOT_TOKEN=
